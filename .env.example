# ---------------------------------------------------------------------------
# Dussa BakeLab — environment variables
#
# Copy this to .env.local for local development, and add the same values in
# Vercel under Settings → Environment Variables for the live site.
# ---------------------------------------------------------------------------

# 1) DATABASE — required for orders to be saved
#
# Orders, products and settings all live in one Postgres database. Any Postgres
# works; Neon (neon.com) has a free tier that suits a bakery this size.
# Create a project, copy the connection string, paste it here.
#
# Without this the site still runs, but orders are held in memory and vanish
# when the serverless function sleeps — the dashboard warns you until it is set.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 2) DASHBOARD PASSWORD — required before going live
#
# The password for /admin. Any long phrase you will remember.
# While this is unset, ANY value opens the dashboard.
ADMIN_KEY=

# 3) EMAIL NOTIFICATIONS — optional but recommended
#
# Create a free account at resend.com and paste the API key below.
# You get emailed on every new order; customers get a confirmation with their
# order code and an update each time you move their order along.
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=

# Once you have verified your own domain in Resend, send from your own address.
# Until then leave this unset and Resend's shared test sender is used.
ORDER_NOTIFY_FROM="Dussa BakeLab <orders@resend.dev>"

# 4) CORS — optional
#
# Restrict the API to your own domain. Defaults to * when unset.
ALLOWED_ORIGIN=

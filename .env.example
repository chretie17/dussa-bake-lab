# ---------------------------------------------------------------------------
# Dussa BakeLab — environment variables
#
# Copy this to .env.local for local development, and add the same values in
# Vercel under Settings → Environment Variables for the live site.
# ---------------------------------------------------------------------------

# 1) DATABASE — required for orders to be saved
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 2) DASHBOARD PASSWORD — required before going live
ADMIN_KEY=

# 3) EMAIL NOTIFICATIONS — optional but recommended
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=
ORDER_NOTIFY_FROM="Dussa BakeLab <orders@resend.dev>"

# 4) CORS — optional
ALLOWED_ORIGIN=

# 5) WHATSAPP — optional
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=250788722064
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ADMINS=
WHATSAPP_WABA_ID=

# Only needed if the 24-hour reply window keeps closing for notifications sent
# to the bakery's own WhatsApp number.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# 6) WHATSAPP UPDATES FOR CUSTOMERS — optional
#
# Approved Meta Utility templates used for customer order confirmations and
# status updates. The currently approved confirmation has 6 body variables and
# the status template has 4.
WHATSAPP_CUSTOMER_TEMPLATE=dussa_order_confirmation
WHATSAPP_STATUS_TEMPLATE=dussa_order_status

# These templates were created with different language variants, so configure
# them independently. Confirmation is English (US); status is English.
WHATSAPP_CUSTOMER_TEMPLATE_LANG=en_US
WHATSAPP_STATUS_TEMPLATE_LANG=en

# 7) PAYMENTS — optional
#
# The Mobile Money number is fixed in the approved confirmation template. This
# setting is still used by plain-text fallback messages and the website UI.
MOMO_NUMBER="+250 788 722 064"

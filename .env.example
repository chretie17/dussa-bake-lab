# ---------------------------------------------------------------------------
# Dussa BakeLab — environment variables
#
# Copy to .env.local for local runs, or add these in your Vercel project under
# Settings → Environment Variables. Everything here is optional: the site works
# without any of it, but orders will not survive a cold start and the kitchen
# dashboard will be open to anyone with the link.
# ---------------------------------------------------------------------------

# 1) ORDER STORAGE (strongly recommended)
# Any Upstash-compatible Redis REST endpoint. Create a free database at
# upstash.com, or add Vercel KV from the Storage tab — Vercel injects the
# KV_REST_API_* pair for you automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash's own variable names are read as a fallback:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 2) DASHBOARD KEY (required before going live)
# The password for /admin. While this is unset, any key opens the dashboard.
ADMIN_KEY=

# 3) EMAIL ALERTS (optional)
# Get a key at resend.com to be emailed whenever an order comes in.
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=
ORDER_NOTIFY_FROM="Dussa BakeLab <orders@resend.dev>"

# 4) CORS (optional)
# Lock the API to your own domain. Defaults to * when unset.
ALLOWED_ORIGIN=

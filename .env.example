# ---------------------------------------------------------------------------
# Dussa BakeLab — environment variables
#
# Copy this to .env.local for local development, and add the same values in
# Vercel under Settings → Environment Variables for the live site.
# ---------------------------------------------------------------------------

# 1) DATABASE — required for orders to be saved
#
# Orders, products and settings all live in one Postgres database. Any Postgres
# works; Neon (neon.com) has a free tier that suits a bakery this size.
# Create a project, copy the connection string, paste it here.
#
# Without this the site still runs, but orders are held in memory and vanish
# when the serverless function sleeps — the dashboard warns you until it is set.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 2) DASHBOARD PASSWORD — required before going live
#
# The password for /admin. Any long phrase you will remember.
# While this is unset, ANY value opens the dashboard.
ADMIN_KEY=

# 3) EMAIL NOTIFICATIONS — optional but recommended
#
# Create a free account at resend.com and paste the API key below.
# You get emailed on every new order; customers get a confirmation with their
# order code and an update each time you move their order along.
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=

# Once you have verified your own domain in Resend, send from your own address.
# Until then leave this unset and Resend's shared test sender is used.
ORDER_NOTIFY_FROM="Dussa BakeLab <orders@resend.dev>"

# 4) CORS — optional
#
# Restrict the API to your own domain. Defaults to * when unset.
ALLOWED_ORIGIN=

# 5) WHATSAPP — optional
#
# Sends every new order to your WhatsApp, and lets you reply with commands like
# "confirm DBL-K2XMQ4A", "today" or "new" to manage orders from your phone.
#
# Make an app at developers.facebook.com, add the WhatsApp product, then:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=250788722064

# Point Meta's callback URL at https://yourdomain.com/api/whatsapp and use the
# same words here as you type into the "Verify token" box.
WHATSAPP_VERIFY_TOKEN=

# From your app's Basic Settings. Lets us check each webhook really came from
# Meta. Strongly recommended once you are live.
WHATSAPP_APP_SECRET=

# Other numbers allowed to send commands, comma separated.
WHATSAPP_ADMINS=

# Your WhatsApp Business Account ID, from the same API Setup page as the phone
# number id. Optional, but with it the dashboard's "Why is WhatsApp not
# delivering?" check can read your templates and tell you whether their names,
# languages and parameter counts actually match what the site sends.
WHATSAPP_WABA_ID=

# Only needed if the 24-hour reply window keeps closing: the name of an
# approved message template to send YOUR OWN notifications through instead.
WHATSAPP_TEMPLATE=

# 6) WHATSAPP UPDATES FOR CUSTOMERS — optional
#
# Sends the customer a WhatsApp confirmation the moment they order, then a
# message every time you move the order along (confirmed, baking, ready, done,
# cancelled). Customers can untick this at checkout.
#
# Meta will not let you message someone who has not messaged you in the last
# 24 hours unless it goes through a template they have approved, so create
# these two in Meta Business Manager → WhatsApp Manager → Message templates,
# category "Utility". README.md has the exact text to paste. Approval usually
# takes a few minutes.
WHATSAPP_CUSTOMER_TEMPLATE=dussa_order_confirmation
WHATSAPP_STATUS_TEMPLATE=dussa_order_status

# The language code you picked when creating the templates. Must match, or Meta
# rejects the send with error 132001.
WHATSAPP_TEMPLATE_LANG=en

# 7) PAYMENTS — optional
#
# The Mobile Money number customers are asked to pay. Normally you set this in
# the dashboard under Settings, which is what the confirmation message uses;
# this is only the fallback for before any settings are saved.
MOMO_NUMBER="+250 788 722 064"
